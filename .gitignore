.installed.cfg
*.egg

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.bak
*.swp

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# IDEs & Editors
.idea/
