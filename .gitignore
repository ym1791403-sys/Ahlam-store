# ============================================================
# SECURITY & SECRETS EXCLUSIONS (PREVENT LEAKS ON GITHUB)
# ============================================================
# Environment variables & secrets
.env
.env.*
*.env
*.local
credentials.json
secrets.json
auth.json
token.txt
client_secret*.json

# Private keys & certificates
*.pem
*.key
*.pfx
*.p12
*.crt
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
